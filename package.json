{
  "name": "dupuytren-directory",
  "version": "0.1.0",
  "private": true,
  "description": "A searchable directory of doctors who treat Dupuytren's contracture and Ledderhose disease, filterable by the treatments they actually offer.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:setup": "node scripts/db/migrate.mjs && node scripts/db/seed.mjs",
    "data:build": "python3 scripts/ingest/build.py",
    "test": "python3 -m unittest discover -s tests"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "leaflet": "1.9",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9"
  }
}
